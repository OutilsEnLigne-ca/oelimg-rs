{
  "name": "oelimg-rs",
  "version": "0.1.0",
  "description": "Package d'édition d'images pour outilsenligne.ca, en Rust avec WASM.",
  "main": "pkg/oelimg_rs.js",
  "types": "pkg/oelimg_rs.d.ts",
  "files": [
    "pkg/*"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg --out-name oelimg_rs",
    "build:nodejs": "wasm-pack build --target nodejs --out-dir pkg --out-name oelimg_rs",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg --out-name oelimg_rs",
    "build:all": "npm run build && npm run build:nodejs && npm run build:bundler",
    "dev": "wasm-pack build --dev --target web --out-dir pkg --out-name oelimg_rs",
    "test": "wasm-pack test --headless --firefox",
    "clean": "rm -rf pkg/ target/",
    "publish:npm": "wasm-pack publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outilsenligne/oelimg-rs"
  },
  "keywords": [
    "image-processing",
    "webassembly",
    "wasm",
    "rust",
    "filters",
    "nextjs",
    "javascript"
  ],
  "author": "OutilsEnLigne.ca Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "wasm-pack": "^0.12.1"
  },
  "publishConfig": {
    "access": "public"
  }
}